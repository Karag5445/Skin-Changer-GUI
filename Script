local RemovePart = Tab2:CreateDropdown({
    Name = "Remove body part",
    Options = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"},
    CurrentOption = {"---"},
    MultipleOptions = false,
    Flag = "PlayerDropdown",
    Callback = function(Options)
        print("Выбран: " .. Options[1])
      
        local character = workspace:FindFirstChild(nickname, true) 
        if character and character:IsA("Model") then
            local parts = character:GetChildren()

            for _, part in ipairs(parts) do
                if Options[1] == part.Name then
                    part:Destroy()    
                end
            end
        end
        
        Rayfield:Notify({
                Title = "Console",
                Content = "Part removed ✅",
                Duration = 3
        })
    end,
})

